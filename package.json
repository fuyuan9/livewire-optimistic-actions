{
  "name": "livewire-optimistic-actions",
  "version": "0.1.0",
  "description": "Declarative optimistic actions for Livewire",
  "type": "module",
  "main": "dist/livewire-optimistic-actions.js",
  "module": "dist/livewire-optimistic-actions.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && prettier --check \"resources/js/**/*.ts\" \"tests-js/**/*.ts\"",
    "format": "prettier --write \"resources/js/**/*.ts\" \"tests-js/**/*.ts\""
  },
  "devDependencies": {
    "happy-dom": "^20.10.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8"
  }
}
