{
    "name": "fuyuan9/livewire-optimistic-actions",
    "version": "0.1.0",
    "description": "Declarative optimistic actions for Livewire. Server-first, Blade-first, rebase-first.",
    "license": "MIT",
    "authors": [
        {
            "name": "Fuyuan",
            "email": "fu9fu9fu9@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Fuyuan9\\Livewire\\OptimisticActions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fuyuan9\\Livewire\\OptimisticActions\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fuyuan9\\Livewire\\OptimisticActions\\LivewireOptimisticActionsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}